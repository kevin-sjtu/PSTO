# Local environments and Python caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Local datasets, training checkpoints, diagnostics and logs
*.mat
*.h5
*.hdf5
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.csv
*.log
*.out
*.err
log
log.*
slurm-*
**/checkpoints/**
**/logs/
**/data/cache/
**/data_cache/
**/analysis/figures/
**/analysis/results*/
**/analysis/performance/results/
**/analysis/performance/*.json
**/data/*_sampling.json
**/outputs/
**/runs/
**/work/

