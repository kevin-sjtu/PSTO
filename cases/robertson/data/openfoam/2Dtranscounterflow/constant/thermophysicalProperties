FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         reactingMixture;
    transport       const;
    thermo          hConst;
    energy          sensibleEnthalpy;
    equationOfState rhoConst;
    specie          specie;
}
inertSpecie D;

chemistryReader foamChemistryReader;

foamChemistryFile "$FOAM_CASE/constant/reactions";
foamChemistryThermoFile "$FOAM_CASE/constant/thermo.compressibleGas";

mixture
{   
    specie
    {
        molWeight   25.9;
    }
    equationOfState
    {
        rho         1.0;
    }
    thermodynamics
    {   Hf          0;
        Cp          1000;       // 固定值 [J/(kg·K)]
    }

    transport
    {   
        kappa       1;  // 导热系数 [W/(m·K)]
        mu          1e-4;  // 动力粘度（示例值）
        Pr          0.1;    // 普朗特数
    }
}


