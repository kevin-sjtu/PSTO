FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     reactingFoam; // Matches the supplied run script and measured solver.

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         5e-3;

deltaT          1e-7;

maxDeltaT       1e-6;

adjustTimeStep  off;

writeControl    adjustableRunTime;

writeInterval   1e-6;

purgeWrite      0;

writeFormat     ascii;

writePrecision    6;

writeCompression on;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

// adjustTimeStep yes;

// maxCo  0.8;


